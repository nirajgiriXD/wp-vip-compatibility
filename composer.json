{
  "name": "nirajgirixd/preflight-audit",
  "description": "Checks a WordPress site against the WordPress VIP Platform requirements before migrating.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "brain/monkey": "^2.6",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "psr-4": {
      "PREFLIGHT_AUDIT\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
