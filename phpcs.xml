<?xml version="1.0"?>
<ruleset name="WP VIP Compatibility">
	<description>The WordPress VIP coding standards, applied to this plugin's own source.</description>

	<arg name="extensions" value="php"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>

	<arg value="psvn"/>

	<arg name="parallel" value="8"/>

	<file>.</file>

	<rule ref="WordPress-VIP-Go" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress-Docs" />

	<rule ref="PEAR.NamingConventions.ValidClassName.StartWithCapital">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<severity>0</severity>
	</rule>

	<!--
		The plugin bootstrap file has to be named after the plugin so WordPress
		can find it, which conflicts with the class-file naming convention for
		the loader class it contains.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/wp-vip-compatibility.php</exclude-pattern>
	</rule>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
</ruleset>
