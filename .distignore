# Development tooling and version control. None of it runs at plugin runtime.
node_modules/
.git/
.gitattributes
.gitignore
.github
dist/
.idea
.vscode/
webpack.config.js
postcss.config.js
composer.*
package*.json
phpcs.xml
.editorconfig
.distignore
.DS_Store
Thumbs.db

# Repository documentation. readme.txt is the file the Plugin Directory reads.
README.md
WORKFLOW.md
CODE_OF_CONDUCT.md

# Directory assets. These belong in the /assets/ folder of the plugin's SVN
# repository, not inside the plugin ZIP — shipping them just makes the download
# larger for every user. The stylesheet and script under assets/ are runtime
# files and are deliberately not matched by these patterns.
assets/screenshot-*.png
assets/banner-*.png
assets/icon-*.png

# LICENSE is deliberately NOT excluded: the GPL requires the licence text to be
# distributed with the software it covers.
